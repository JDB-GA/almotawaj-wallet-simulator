# Copy to .env and fill in. Every service reads it.
DB_USERNAME=postgres
DB_PASSWORD=change_me
WALLET_DB_URL=jdbc:postgresql://localhost:5432/wallet
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/identity
AUDIT_DB_URL=jdbc:postgresql://localhost:5432/audit

JWT_SECRET=change_me
JWT_EXPIRATION_MS=86400000
OTP_SECRET=change_me

RESEND_API_KEY=change_me
MAIL_FROM=Almotawaj Digital Wallet <no-reply@notify.almotawaj.com>
MAIL_LOGO_URL=https://almotawaj.com/logo/logo.png

APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
STORAGE_ROOT=uploads

SEED_TOKEN=change_me
SEED_PASSWORD=change_me

# Shared by services that call each other's /internal APIs
INTERNAL_API_TOKEN=change_me
IDENTITY_URL=http://localhost:8081
WALLET_URL=http://localhost:8080
AUDIT_URL=http://localhost:8083
