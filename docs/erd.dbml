Enum user_role {
  CLIENT
  MERCHANT
  ADMIN
  SUPER_ADMIN
}

Enum user_status {
  ACTIVE
  LOCKED
  SUSPENDED
  CLOSED
}

Enum kyc_status {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

Enum kyc_application_status {
  PENDING
  APPROVED
  REJECTED
}

Enum kyc_document_type {
  CPR
  PASSPORT
  PHOTO
}

Enum otp_purpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

Enum permission {
  KYC_REVIEW
  USER_MANAGE
  STATISTICS_VIEW
}

Enum transaction_type {
  TOP_UP
  PAYMENT
  PAYMENT_RECEIVED
  REFUND
  REFUND_ISSUED
  TRANSFER_IN
  TRANSFER_OUT
  VOUCHER_PURCHASE
  VOUCHER_SALE
  PAYOUT_SENT
  PAYOUT_RECEIVED
}

Enum transaction_direction {
  CREDIT
  DEBIT
}

Enum payment_request_status {
  PENDING
  PAID
  DECLINED
  CANCELLED
}

Enum checkout_status {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

Table users {
  id                      uuid         [pk]
  email_address           varchar(254) [not null, unique]
  mobile_number           varchar(12)  [not null, unique, note: '+973 followed by 8 digits']
  password                varchar(255) [not null, note: 'BCrypt hash']
  role                    user_role    [not null, default: 'CLIENT']
  status                  user_status  [not null, default: 'ACTIVE', note: 'CLOSED = soft deleted']
  kyc_status              kyc_status   [not null, default: 'NOT_SUBMITTED']
  email_verified          boolean      [not null, default: false]
  mobile_verified         boolean      [not null]
  credentials_changed_at  timestamptz  [note: 'Tokens issued before this are rejected']
  display_name            varchar(70)  [note: 'Business name of a merchant']
  picture_key             varchar(255) [note: 'Stored file name of the profile picture']
  picture_content_type    varchar(50)
  created_at              timestamptz  [not null]
  updated_at              timestamptz  [not null]
}

Table user_permissions {
  user_id     uuid        [not null, ref: > users.id]
  permission  permission  [not null]

  indexes {
    (user_id, permission) [unique]
  }
}

Table otp_challenges {
  id           uuid         [pk]
  user_id      uuid         [not null, ref: > users.id]
  purpose      otp_purpose  [not null]
  code_hash    varchar(64)  [not null, note: 'HMAC-SHA256 of user, purpose and code']
  attempts     integer      [not null, default: 0]
  expires_at   timestamptz  [not null]
  consumed_at  timestamptz
  created_at   timestamptz  [not null]

  indexes {
    (user_id, purpose)
  }
}

Table kyc_applications {
  id                uuid                    [pk]
  user_id           uuid                    [not null, ref: > users.id]
  status            kyc_application_status  [not null, default: 'PENDING']
  full_name         varchar(150)            [not null]
  cpr_number        varchar(9)              [not null]
  date_of_birth     date                    [not null]
  nationality       varchar(2)              [not null, note: 'ISO 3166-1 alpha-2']
  block             varchar(10)             [not null]
  road              varchar(10)             [not null]
  building          varchar(10)             [not null]
  flat              varchar(10)
  area              varchar(100)            [not null]
  rejection_reason  varchar(500)
  reviewed_by       uuid                    [ref: > users.id, note: 'Null until an admin decides']
  reviewed_at       timestamptz
  created_at        timestamptz             [not null]
  updated_at        timestamptz             [not null]

  indexes {
    (user_id, status)
    cpr_number
  }
}

Table kyc_documents {
  id              uuid               [pk]
  application_id  uuid               [not null, ref: > kyc_applications.id]
  type            kyc_document_type  [not null]
  expiry_date     date               [note: 'Required for CPR and PASSPORT']
  storage_key     varchar(255)       [not null, unique, note: 'Random file name on the storage volume']
  content_type    varchar(50)        [not null]
  size_bytes      bigint             [not null]
  created_at      timestamptz        [not null]

  indexes {
    (application_id, type) [unique]
  }
}

Table audit_logs {
  id           uuid          [pk]
  actor_id     uuid          [ref: > users.id, note: 'Who performed the action; null for the system']
  action       varchar(40)   [not null, note: 'AuditAction enum name']
  target_type  varchar(40)   [not null, note: 'USER, KYC_APPLICATION, PAYMENT_REQUEST, WALLET_TRANSACTION, API_KEY or CHECKOUT_SESSION']
  target_id    uuid          [not null]
  details      varchar(500)
  created_at   timestamptz   [not null]

  indexes {
    created_at
    action
    target_id
  }
}

Table wallets {
  id          uuid           [pk]
  user_id     uuid           [not null, unique, ref: - users.id, note: 'One wallet per user']
  iban        varchar(22)    [not null, unique, note: 'Generated BH IBAN, never changes']
  balance     numeric(19,3)  [not null, note: 'BHD']
  currency    varchar(3)     [not null, note: 'BHD']
  created_at  timestamptz    [not null]
  updated_at  timestamptz    [not null]
}

Table wallet_transactions {
  id                   uuid                   [pk]
  wallet_id            uuid                   [not null, ref: > wallets.id]
  reference            varchar(24)            [not null, unique, note: 'TXN-yyyyMMdd-XXXXXXXX']
  type                 transaction_type       [not null]
  direction            transaction_direction  [not null]
  amount               numeric(19,3)          [not null]
  balance_after        numeric(19,3)          [not null]
  counterparty_name    varchar(70)            [not null]
  counterparty_iban    varchar(34)
  counterparty_bic     varchar(11)
  counterparty_email   varchar(254)           [note: 'Masked']
  counterparty_mobile  varchar(12)            [note: 'Masked']
  description          varchar(140)           [note: 'Note, bank name or order reference']
  created_at           timestamptz            [not null]

  indexes {
    (wallet_id, created_at)
  }
}

Table payment_requests {
  id            uuid                    [pk]
  requester_id  uuid                    [not null, ref: > users.id, note: 'Who asks for the money']
  payer_id      uuid                    [not null, ref: > users.id, note: 'Who is asked to pay']
  amount        numeric(19,3)           [not null]
  note          varchar(140)
  status        payment_request_status  [not null, default: 'PENDING']
  created_at    timestamptz             [not null]
  updated_at    timestamptz             [not null]

  indexes {
    (requester_id, created_at)
    (payer_id, created_at)
  }
}

Table merchant_api_keys {
  id            uuid         [pk]
  merchant_id   uuid         [not null, ref: > users.id]
  name          varchar(50)  [not null]
  key_prefix    varchar(12)  [not null, note: 'First characters, shown in the dashboard']
  key_hash      varchar(64)  [not null, unique, note: 'SHA-256 of the key']
  last_used_at  timestamptz
  revoked_at    timestamptz  [note: 'Null while the key is active']
  created_at    timestamptz  [not null]

  indexes {
    (merchant_id, created_at)
  }
}

Table merchant_webhooks {
  id           uuid          [pk, note: 'The signing secret is derived from this id']
  merchant_id  uuid          [not null, unique, ref: - users.id, note: 'One callback URL per merchant']
  url          varchar(500)  [not null]
  created_at   timestamptz   [not null]
  updated_at   timestamptz   [not null]
}

Table checkout_sessions {
  id               uuid             [pk]
  merchant_id      uuid             [not null, ref: > users.id]
  payer_id         uuid             [ref: > users.id, note: 'Set when the session is paid']
  order_reference  varchar(64)      [not null, note: 'The merchant order id']
  amount           numeric(19,3)    [not null]
  description      varchar(140)
  return_url       varchar(500)     [note: 'Where the customer is sent after paying']
  voucher_discount numeric(19,3)    [note: 'Part of the amount covered by a voucher']
  status           checkout_status  [not null, default: 'PENDING']
  expires_at       timestamptz      [not null]
  paid_at          timestamptz
  refunded_at      timestamptz
  created_at       timestamptz      [not null]
  updated_at       timestamptz      [not null]

  indexes {
    (merchant_id, order_reference) [unique, note: 'One session per order']
    (merchant_id, created_at)
    (status, expires_at)
  }
}

// Project 3

Enum voucher_status {
  ACTIVE
  PAUSED
  SOLD_OUT
  EXPIRED
}

Enum voucher_purchase_status {
  UNUSED
  REDEEMED
}

Enum payout_batch_status {
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
}

Enum payout_item_status {
  PENDING
  PAID
  FAILED
}

Table vouchers {
  id                uuid            [pk]
  merchant_id       uuid            [not null, ref: > users.id]
  title             varchar(70)     [not null]
  price             numeric(19,3)   [not null, note: 'What the client pays']
  face_value        numeric(19,3)   [not null, note: 'What the voucher is worth']
  total_quantity    int             [not null]
  remaining         int             [not null, note: 'Shared stock; check remaining >= 0']
  per_client_limit  int             [not null]
  status            voucher_status  [not null, default: 'ACTIVE']
  sale_ends_at      timestamptz     [not null, note: 'Last moment the voucher can be bought']
  expires_at        timestamptz     [note: 'Bought vouchers cannot be used after this; null means never']
  version           bigint          [not null, note: 'Optimistic lock']
  created_at        timestamptz     [not null]
  updated_at        timestamptz     [not null]

  indexes {
    (merchant_id, created_at)
    (status, sale_ends_at)
  }
}

Table voucher_purchases {
  id              uuid           [pk]
  voucher_id      uuid           [not null, ref: > vouchers.id]
  buyer_id        uuid           [not null, ref: > users.id]
  transaction_id  uuid           [not null, ref: - wallet_transactions.id, note: 'The buyer debit']
  code            varchar(20)    [not null, unique, note: 'Voucher code given to the buyer']
  price           numeric(19,3)  [not null]
  status          voucher_purchase_status [not null, default: 'UNUSED']
  redeemed_checkout_id uuid      [ref: > checkout_sessions.id, note: 'The checkout the voucher paid for']
  redeemed_at     timestamptz
  created_at      timestamptz    [not null]

  indexes {
    (voucher_id, buyer_id)
    (buyer_id, created_at)
  }
}

Table payout_batches {
  id              uuid                 [pk]
  merchant_id     uuid                 [not null, ref: > users.id]
  status          payout_batch_status  [not null, default: 'PROCESSING']
  item_count      int                  [not null]
  paid_count      int                  [not null, default: 0]
  failed_count    int                  [not null, default: 0]
  total_amount    numeric(19,3)        [not null]
  created_at      timestamptz          [not null]
  completed_at    timestamptz

  indexes {
    (merchant_id, created_at)
  }
}

Table payout_items {
  id              uuid                [pk]
  batch_id        uuid                [not null, ref: > payout_batches.id]
  recipient_id    uuid                [not null, ref: > users.id]
  transaction_id  uuid                [ref: - wallet_transactions.id, note: 'Set when paid']
  amount          numeric(19,3)       [not null]
  status          payout_item_status  [not null, default: 'PENDING']
  failure_reason  varchar(60)
  processed_at    timestamptz

  indexes {
    (batch_id)
  }
}

Table idempotency_records {
  id               uuid         [pk]
  user_id          uuid         [not null, ref: > users.id]
  idempotency_key  varchar(64)  [not null]
  endpoint         varchar(60)  [not null]
  response_status  int          [not null]
  response_body    text         [not null, note: 'Returned again when the key repeats']
  created_at       timestamptz  [not null]

  indexes {
    (user_id, idempotency_key) [unique]
  }
}

